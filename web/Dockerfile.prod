# Brand-Ops web GUI, production image: build the Vite SPA, serve it with nginx.
#
# The SPA talks to the backend over relative /api/... paths; nginx proxies those
# to the brand-ops-backend container (see nginx.conf). This image is built and
# run separately from the backend image so a frontend change never rebuilds or
# restarts the API.

# Build stage
# Pinned to an exact Node patch so the build is reproducible.
# TODO: digest-pin (@sha256) under renovate
FROM node:20.18.0-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# Production stage
# Pinned to an exact nginx patch on alpine so a rebuild is reproducible.
# TODO: digest-pin (@sha256) under renovate
#
# TODO: run nginx as non-root via nginxinc/nginx-unprivileged. That image runs
# as uid 101 and listens on 8080 (an unprivileged port), not 80. Migrating it is
# a coordinated change that touches files outside this Dockerfile and so is left
# for a dedicated pass:
#   1. base image  -> nginxinc/nginx-unprivileged:<pinned>-alpine
#   2. web/nginx.conf -> `listen 8080;` (the unprivileged image cannot bind 80)
#   3. this file    -> EXPOSE 8080 and the HEALTHCHECK URL -> :8080
#   4. compose      -> brand-ops-frontend `expose: "8080"`, the healthcheck URL,
#                      and the oauth2-proxy OAUTH2_PROXY_UPSTREAMS frontend entry
#                      http://brand-ops-frontend:80 -> :8080
# All four must land together; a half-migration (unprivileged image still told to
# listen on 80) will not start. Until then nginx runs as root in this image.
FROM nginx:1.27.3-alpine AS production
COPY --from=builder /app/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:80/nginx-health || exit 1

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
