# Brand-Ops web GUI, production image: build the Vite SPA, serve it with nginx.
#
# The SPA talks to the backend over relative /api/... paths; nginx proxies those
# to the brand-ops-backend container (see nginx.conf). This image is built and
# run separately from the backend image so a frontend change never rebuilds or
# restarts the API.

# Build stage
FROM node:20-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# Production stage
FROM nginx:alpine AS production
COPY --from=builder /app/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:80/nginx-health || exit 1

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
