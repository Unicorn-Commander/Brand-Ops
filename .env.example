# Copy to .env and fill in. Never commit .env.

# Image backends
GEMINI_API_KEY=
OPENAI_API_KEY=
RECRAFT_API_KEY=

# Local FLUX (ComfyUI) endpoint
COMFYUI_URL=http://localhost:8188

# Brigade (autonomy + federation hub)
BRIGADE_BASE_URL=https://brigade.unicorncommander.ai
BRIGADE_API_KEY=

# Storage (Garage S3, output mirror)
GARAGE_S3_ENDPOINT=
GARAGE_S3_ACCESS_KEY=
GARAGE_S3_SECRET_KEY=
GARAGE_S3_REGION=garage
GARAGE_S3_BUCKET=brand-ops-assets

# Auth (Keycloak uchub realm)
KEYCLOAK_REALM_URL=https://auth.unicorncommander.ai/realms/uchub
KEYCLOAK_CLIENT_ID=brand-ops
KEYCLOAK_CLIENT_SECRET=

# Database
DATABASE_URL=postgresql+asyncpg://brand_ops_app:CHANGEME@localhost:5432/brand_ops
