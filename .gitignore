# Generated and imported assets are managed outside git
brand-kits/*/generated/
brand-kits/*/imported/

# The append-only activity / provenance feed is runtime state, not source.
brand-kits/.activity.jsonl

# Secrets. The .env.bak leak that burned Contact-Ops is the reason for the last line.
.env
.env.*
!.env.example
.env.bak*

# Python
__pycache__/
*.pyc
.venv/
.uv/
dist/
build/
*.egg-info/

# OS
.DS_Store

# Curation quarantine: reversible holding pen for junk assets, not source.
_asset-quarantine/

# Ad-hoc backup files from live-ops edits (*.py.bak-<date>, compose baks).
*.bak-*
*.bak.*

# Per-workspace kit subtrees (brand-kits/<workspace-uuid>/...) are runtime
# tenant state, not source. The flat-root kits above them are the seeds.
brand-kits/????????-????-????-????-????????????/
